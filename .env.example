# Copy to .env.local.
#
# The Vite app reads these first:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
#
# Vercel Marketplace / Next.js integrations often inject these names instead.
# The build maps them automatically, so you do not have to duplicate them:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
